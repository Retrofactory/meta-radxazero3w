--- a/drivers/video/rockchip/rk_vop2.c
+++ b/drivers/video/rockchip/rk_vop2.c
@@ -13,6 +13,9 @@
 #include <dm/device_compat.h>
 #include <edid.h>
 #include <log.h>
+#include <lmb.h>
+#include <malloc.h>
+#include <linux/libfdt.h>
 #include <regmap.h>
 #include <reset.h>
 #include <syscon.h>
@@ -462,11 +465,258 @@
 	uc_priv->bpix = l2bpp;
 
 	priv->vp = port_id;
+	priv->output_mode = vop_id;
+	priv->timing = timing;
