+struct bd_info;
+int rk_vop2_arcadia_handoff(void *blob);
+void rk_vop2_arcadia_handoff_reset(void);
+static bool arcadia_bootm_active;
+
+void board_bootm_start(void)
+{
+	rk_vop2_arcadia_handoff_reset();
+	arcadia_bootm_active = true;
+}
+
+void board_bootm_cancel(void)
+{
+	rk_vop2_arcadia_handoff_reset();
+	arcadia_bootm_active = false;
+}
+
+int ft_board_setup(void *blob, struct bd_info *bd)
+{
+	rk_vop2_arcadia_handoff_reset();
+	if (arcadia_bootm_active && env_get_yesno("arcadia_handoff") == 1)
+		rk_vop2_arcadia_handoff(blob);
+	return 0;
+}
+#endif
 
