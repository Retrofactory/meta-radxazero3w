 	debug("fb=%lx, size=%d %d\n", fbbase,
 	      uc_priv->xsize, uc_priv->ysize);
 
 	return 0;
+}
+
+/* Local diagnostic: preserve scanout only after a complete, validated FDT handoff. */
+extern bool arcadia_artwork_shown;
+static bool arcadia_handoff_ready;
+
+void rk_vop2_arcadia_handoff_reset(void)
+{
+	arcadia_handoff_ready = false;
+}
+
+/* Require one existing non-overwritable LMB region to cover every byte. */
+static bool arcadia_fb_reserved(ulong base, ulong size)
+{
+	struct lmb *map = lmb_get();
+	struct lmb_region *regions = map->used_mem.data;
+	int i;
+
+	if (!size || base + size < base)
+		return false;
+	for (i = 0; i < map->used_mem.count; i++) {
+		struct lmb_region *r = &regions[i];
+		ulong offset;
+
+		if (!(r->flags & LMB_NOOVERWRITE) || base < r->base)
+			continue;
+		offset = base - r->base;
+		if (offset <= r->size && size <= r->size - offset)
+			return true;
+	}
+	return false;
+}
+
+static bool arcadia_fdt_enabled(const void *blob, int node)
+{
+	const char *status;
+	int len;
+
+	status = fdt_getprop(blob, node, "status", &len);
+	if (!status)
+		return len == -FDT_ERR_NOTFOUND;
+	return (len == 3 && !memcmp(status, "ok", 3)) ||
+	       (len == 5 && !memcmp(status, "okay", 5));
+}
+
+/* Only preserve if Linux is explicitly requested to use the tested mode. */
+static bool arcadia_linux_mode_matches(const void *blob)
+{
+	static const char prefix[] = "video=";
+	static const char allowed[] = "video=HDMI-A-1:1920x1080@60";
+	const char *args, *end, *p;
+	int chosen, len, matches = 0;
+
+	chosen = fdt_path_offset(blob, "/chosen");
+	if (chosen < 0)
+		return false;
+	args = fdt_getprop(blob, chosen, "bootargs", &len);
+	if (!args || len < 1 || args[len - 1] != '\0' ||
+	    strnlen(args, len) != (size_t)len - 1)
+		return false;
+	end = args + len - 1;
+	/* Reject shell quoting/escaping and non-space whitespace; do not guess
+	 * how the kernel will split such a command line.
+	 */
+	for (p = args; p < end; p++) {
+		if ((*p > 0 && *p < ' ') || *p == '\\' || *p == '\"' || *p == '\'')
+			return false;
+	}
+	for (p = args; p < end;) {
+		const char *start;
+		size_t n;
+
+		while (p < end && *p == ' ')
+			p++;
+		start = p;
+		while (p < end && *p != ' ')
+			p++;
+		n = p - start;
+		if (n == 2 && !memcmp(start, "--", 2))
+			return false;
+		if (n >= sizeof(prefix) - 1 &&
+		    !memcmp(start, prefix, sizeof(prefix) - 1)) {
+			if (n != sizeof(allowed) - 1 ||
+			    memcmp(start, allowed, sizeof(allowed) - 1))
+				return false;
+			matches++;
+		}
+	}
+	return matches == 1;
+}
+
+bool rk_vop2_arcadia_handoff_ready(void)
+{
+	return arcadia_handoff_ready;
+}
+
+int rk_vop2_arcadia_handoff(void *blob)
+{
+	struct udevice *dev;
+	struct rk_vop2_priv *priv;
+	struct video_priv *vpriv;
+	struct video_uc_plat *plat;
+	struct display_timing *t;
+	fdt32_t reg[4];
+	void *copy;
+	ulong base, size;
+	u32 ep_phandle, logo_phandle;
+	const fdt32_t *regions;
+	int reserve, route, endpoint, display, resparent, vop, hdmi, index, ret;
+	int len, regions_len, ranges_len;
+	static const struct { const char *name; u32 value; } values[] = {
+		{ "logo,offset", 0 }, { "logo,width", 1920 },
+		{ "logo,height", 1080 }, { "logo,bpp", 32 },
+		{ "video,clock", 148500 }, { "video,hdisplay", 1920 },
+		{ "video,vdisplay", 1080 }, { "video,crtc_hsync_end", 2052 },
+		{ "video,crtc_vsync_end", 1089 }, { "video,vrefresh", 60 },
+		{ "video,flags", 5 }, { "video,aspect_ratio", 0 },
+		{ "overscan,left_margin", 100 }, { "overscan,right_margin", 100 },
+		{ "overscan,top_margin", 100 }, { "overscan,bottom_margin", 100 },
+	};
+	int i;
+
+	arcadia_handoff_ready = false;
+	if (!blob || fdt_check_header(blob))
+		return -EINVAL;
+	if (!arcadia_artwork_shown) {
+		printf("Arcadia handoff: no artwork; using normal cleanup\n");
+		return -EINVAL;
+	}
+	if (fdt_node_check_compatible(blob, 0, "radxa,zero-3"))
+		return -EINVAL;
+	if (!arcadia_linux_mode_matches(blob)) {
+		printf("Arcadia handoff: Linux mode not verified; using normal cleanup\n");
+		return -EINVAL;
+	}
+	uclass_find_first_device(UCLASS_VIDEO, &dev);
+	if (!dev || !device_active(dev) || strcmp(dev->name, "vop@fe040000"))
+		return -ENODEV;
+	priv = dev_get_priv(dev);
+	vpriv = dev_get_uclass_priv(dev);
+	plat = dev_get_uclass_plat(dev);
+	t = &priv->timing;
+	if (!priv->timing_valid || priv->vp != 0 ||
+	    priv->output_mode != VOP_MODE_HDMI ||
+	    vpriv->xsize != 1920 || vpriv->ysize != 1080 ||
+	    vpriv->bpix != VIDEO_BPP32 || vpriv->line_length != 7680 ||
+	    t->pixelclock.typ != 148500000 || t->hactive.typ != 1920 ||
+	    t->hfront_porch.typ != 88 || t->hsync_len.typ != 44 ||
+	    t->hback_porch.typ != 148 || t->vactive.typ != 1080 ||
+	    t->vfront_porch.typ != 4 || t->vsync_len.typ != 5 ||
+	    t->vback_porch.typ != 36 ||
+	    !(t->flags & DISPLAY_FLAGS_HSYNC_HIGH) ||
+	    !(t->flags & DISPLAY_FLAGS_VSYNC_HIGH) ||
+	    (t->flags & (DISPLAY_FLAGS_INTERLACED | DISPLAY_FLAGS_DOUBLESCAN |
+			 DISPLAY_FLAGS_DOUBLECLK))) {
+		printf("Arcadia handoff: unsupported display mode; using normal cleanup\n");
+		return -EINVAL;
+	}
+	base = plat->base;
+	size = gd->video_top - gd->video_bottom;
+	if (!base || base != gd->video_bottom || gd->video_top <= base ||
+	    base + size < base || base + size > gd->ram_top ||
+	    (base & 4095) || (size & 4095) || size > 0x4000000 ||
+	    size < (ulong)vpriv->line_length * vpriv->ysize ||
+	    !IS_ENABLED(CONFIG_LMB) || !arcadia_fb_reserved(base, size)) {
+		printf("Arcadia handoff: invalid framebuffer reservation\n");
+		return -EINVAL;
+	}
+	len = fdt_totalsize(blob);
+	copy = malloc(len);
+	if (!copy)
+		return -ENOMEM;
+	ret = fdt_open_into(blob, copy, len);
+	if (ret)
+		goto out;
+	reserve = fdt_path_offset(copy, "/reserved-memory/drm-logo@0");
+	route = fdt_path_offset(copy, "/display-subsystem/route/route-hdmi");
+	display = fdt_path_offset(copy, "/display-subsystem");
+	resparent = fdt_path_offset(copy, "/reserved-memory");
+	vop = fdt_path_offset(copy, "/vop@fe040000");
+	hdmi = fdt_path_offset(copy, "/hdmi@fe0a0000");
+	endpoint = fdt_path_offset(copy, "/vop@fe040000/ports/port@0/endpoint@3");
+	if (reserve < 0 || route < 0 || display < 0 || resparent < 0 ||
+	    vop < 0 || hdmi < 0 || endpoint < 0) {
+		ret = -FDT_ERR_NOTFOUND;
+		goto out;
+	}
+	if (!arcadia_fdt_enabled(copy, reserve) ||
+	    !arcadia_fdt_enabled(copy, resparent) ||
+	    !arcadia_fdt_enabled(copy, route) ||
+	    !arcadia_fdt_enabled(copy, fdt_parent_offset(copy, route)) ||
+	    !arcadia_fdt_enabled(copy, display) ||
+	    !arcadia_fdt_enabled(copy, vop) ||
+	    !arcadia_fdt_enabled(copy, hdmi) ||
+	    !arcadia_fdt_enabled(copy, endpoint) ||
+	    !arcadia_fdt_enabled(copy, fdt_parent_offset(copy, endpoint)) ||
+	    !arcadia_fdt_enabled(copy, fdt_parent_offset(copy, fdt_parent_offset(copy, endpoint))) ||
+	    fdt_address_cells(copy, resparent) != 2 ||
+	    fdt_size_cells(copy, resparent) != 2 ||
+	    !fdt_get_property(copy, resparent, "ranges", &ranges_len) ||
+	    ranges_len != 0) {
+		ret = -FDT_ERR_BADVALUE;
+		goto out;
+	}
+	ep_phandle = fdt_get_phandle(copy, endpoint);
+	logo_phandle = fdt_get_phandle(copy, reserve);
+	index = fdt_stringlist_search(copy, display, "memory-region-names", "drm-logo");
+	regions = fdt_getprop(copy, display, "memory-region", &regions_len);
+	if (!ep_phandle || !logo_phandle || index < 0 || !regions ||
+	    index >= regions_len / (int)sizeof(*regions) ||
+	    fdt32_to_cpu(regions[index]) != logo_phandle) {
+		ret = -FDT_ERR_BADPHANDLE;
+		goto out;
+	}
+	reg[0] = cpu_to_fdt32((u64)base >> 32);
+	reg[1] = cpu_to_fdt32(base);
+	reg[2] = cpu_to_fdt32((u64)size >> 32);
+	reg[3] = cpu_to_fdt32(size);
+	ret = fdt_setprop(copy, reserve, "reg", reg, sizeof(reg));
+	if (ret)
+		goto out;
+	/* A changed property size can move any following node. */
+	route = fdt_path_offset(copy, "/display-subsystem/route/route-hdmi");
+	if (route < 0) {
+		ret = route;
+		goto out;
+	}
+	ret = fdt_setprop_u32(copy, route, "connect", ep_phandle);
+	if (ret)
+		goto out;
+	for (i = 0; i < ARRAY_SIZE(values); i++) {
+		ret = fdt_setprop_u32(copy, route, values[i].name, values[i].value);
+		if (ret)
+			goto out;
+	}
+	memcpy(blob, copy, len);
+	arcadia_handoff_ready = true;
+	printf("Arcadia handoff: reserved framebuffer %lx+%lx for 1080p60 HDMI\n",
+	       base, size);
+out:
+	if (ret)
+		printf("Arcadia handoff: FDT update failed (%d); using normal cleanup\n", ret);
+	free(copy);
+	return ret;
 }
 
